#include "parser.h"
#include "stdint.h"
#include "string.h"




#include <stdlib.h>
#include <string.h>
#define MAX_CMD_SIZE 64
#define MAX_INPUT_SIZE 1024
#define DELIMETER_COUNT 4

static const char * implmented_operations = {"|>"};

const char * isTokenOperator(char * input){
    while(*input){
        for(int i = 0;implmented_operations[i];i++){
            if(*input == implmented_operations[i])
            return implmented_operations+i;
        }
        input++;
    }
    return NULL;
}

execution * parse_command(char *input)
{
    if (strlen(input)>MAX_INPUT_SIZE){
        fprintf(stderr, "Max input size exceeded\n");
        exit(1);
    }
    execution *tail = NULL;
    const char * op_token = NULL;

    execution *node = malloc(sizeof(execution));
    execution *head = node;
    node->args = malloc(sizeof(char *) * MAX_CMD_SIZE);
    node->next_cmd = NULL;

    int i = 0;
    char *arg_ptr; // walking ptr for args
    char *token = strtok_r(input, " ", &arg_ptr);
    
    while (token != NULL) {
        op_token = isTokenOperator(token);
        if (op_token){
            node->next_operation = op_token;
            node->args[i] = NULL;
            node->cmd = node->args[0];
            tail = node;
            node = malloc(sizeof(execution));
            tail->next_cmd = node;
            node->args = malloc(sizeof(char *) * MAX_CMD_SIZE);
            node->next_cmd = NULL;
            i=0;
        }
        else{
        node->args[i] = token;
        i++;
        }
        token = strtok_r(NULL, " ", &arg_ptr);
    }
    tail = node;
    return head;
}


